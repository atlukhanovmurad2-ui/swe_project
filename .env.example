# Copy this to .env and fill in real values. DO NOT commit .env.

# --- VLM (for ingredient identification) ---
LLM_PROVIDER=          # anthropic | openai | gemini
LLM_MODEL=     # provider-specific model id
#ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Nutrition provider ---
NUTRITION_PROVIDER=
USDA_API_KEY=                   # free key from https://fdc.nal.usda.gov/api-key-signup

# --- Storage ---
# PostgreSQL DSN. Leave blank to use an in-memory history log (demo/tests/CI).
# Local server:
#   docker run -d --name pg -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
DATABASE_URL=
# DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres

LOG_LEVEL=INFO                  # CRITICAL | ERROR | WARNING | INFO | DEBUG
NUTRITION_CACHE_TTL_SECONDS=86400
MAX_IMAGE_SIZE_MB=5
HTTP_PORT=8000
MAX_CONCURRENCY=10             # semaphore bound on parallel nutrition lookups
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=8
UPLOAD_DIR=uploads
